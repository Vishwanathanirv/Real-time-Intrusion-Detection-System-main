PORT=8080
DB_FILE=./data/packeteye.db
# Protect attack simulation, live controls and threshold changes ("Authorization: Bearer <token>")
ADMIN_TOKEN=
# Capture from a real interface instead of the simulator (requires tcpdump and CAP_NET_RAW)
CAPTURE_INTERFACE=
# Launch a random simulated attack every 45-105 s; set to "off" to only run attacks on demand
AUTOPILOT=on
# Optional Telegram alerts for high and critical detections
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
